---
import { ANALYTICS_ID } from "../site.js";
import { sitePath } from "../scripts/site-path.js";
import analyticsScript from "../scripts/analytics.js?raw";
---

{import.meta.env.PROD && <>
  <section class="analytics-preferences" data-analytics-consent data-measurement-id={ANALYTICS_ID} aria-labelledby="analytics-heading" hidden>
    <h2 id="analytics-heading">Optional analytics</h2>
    <p>Allow Google Analytics to measure visits to Papers &amp; Pixels? It uses cookies to help us understand which pages are useful. Your files and artwork are not part of these measurements.</p>
    <p><a href={sitePath("/privacy/")}>Read our Privacy Policy</a>. You can change your choice there at any time.</p>
    <p class="analytics-current" data-analytics-current></p>
    <div class="analytics-actions">
      <button data-analytics-decline type="button">Decline analytics</button>
      <button data-analytics-accept type="button">Accept analytics</button>
    </div>
  </section>
  <script is:inline set:html={analyticsScript} />
</>}

<style>
  .analytics-preferences[hidden] { display: none; }
  .analytics-preferences { position: fixed; z-index: 100; bottom: 20px; right: 20px; width: min(440px, calc(100% - 40px)); padding: 24px; border: 1px solid var(--site-border-strong); border-radius: 14px; background: var(--site-surface); color: var(--site-ink); box-shadow: 0 8px 32px var(--site-shadow); }
  h2 { margin: 0 0 12px; font-size: 1.1rem; }
  p { margin: 0 0 12px; font-size: 0.88rem; line-height: 1.7; color: var(--site-muted); }
  a { color: var(--site-accent); font-weight: 600; }
  .analytics-current:empty { display: none; }
  .analytics-actions { display: flex; flex-wrap: wrap; gap: 10px; margin-top: 16px; }
  button { flex: 1; min-height: 44px; padding: 10px 12px; border: 1px solid var(--site-border-strong); border-radius: 8px; font: inherit; font-size: 0.85rem; font-weight: 600; color: var(--site-ink); background: var(--site-surface-soft); cursor: pointer; }
  button:hover { background: var(--site-tint); border-color: var(--site-accent); }
  @media (max-width: 560px) {
    .analytics-preferences { bottom: 12px; right: 12px; width: calc(100% - 24px); padding: 20px; max-height: calc(100dvh - 24px); overflow: auto; }
  }
</style>
