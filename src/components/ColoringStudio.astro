---
import { sitePath } from "../scripts/site-path.js";
import { readdirSync } from "node:fs";
import { starterColoringPages } from "../scripts/coloring-pages.js";
import HowToUse from "./HowToUse.astro";
import UsefulDetails from "./UsefulDetails.astro";
import "../styles/coloring-studio.css";
const pages = starterColoringPages(readdirSync("public/coloring-pages", { withFileTypes: true })
  .filter((entry) => entry.isFile()).map((entry) => entry.name));
---
<section class="cs-page">
  <div class="container cs-container">
    <header class="cs-intro">
      <p class="eyebrow">Creative activities</p>
      <h1>Coloring Studio</h1>
      <p>Choose a page, find your colors, and make it your own.</p>
    </header>
    <div class="cs-studio" data-coloring-studio>
      <input data-file type="file" accept="image/jpeg,image/png,image/webp,.jpg,.jpeg,.png,.webp" hidden />
      <div class="cs-start" data-start>
        <div class="cs-start-heading">
          <div><h2>Start with a page</h2><p>Pick a drawing below, start fresh, or bring your own image.</p></div>
          <div class="cs-start-actions">
            <button class="cs-secondary" data-blank type="button">Blank canvas</button>
            <button class="cs-primary" data-upload type="button">Upload an image</button>
          </div>
        </div>
        <p class="cs-drop-hint">JPG, PNG, or WebP · You can also drop one image here.</p>
        <div class="cs-library-toolbar">
          <label>Find a page <input data-search type="search" placeholder="Search starter pages" /></label>
          <span data-page-count aria-live="polite"></span>
          <div role="group" aria-label="Starter gallery pagination">
            <button class="cs-secondary" data-gallery-prev type="button">Previous</button>
            <button class="cs-secondary" data-gallery-next type="button">Next</button>
          </div>
        </div>
        <div class="cs-templates" role="group" aria-label="Starter pages">
          {pages.map((page, index) => (
            <button class="cs-template" type="button" data-template={sitePath(page.path)} data-title={page.title} hidden={index >= 12}>
              <img src={sitePath(page.path)} width="160" height="200" alt="" loading="lazy" />
              <span class="sr-only">{page.title}</span>
            </button>
          ))}
        </div>
        <p data-empty hidden>No pages match your search. Try another name or start with a blank canvas.</p>
        <noscript><p>Enable JavaScript to color a page.</p></noscript>
      </div>
      <p class="cs-error" data-error role="alert" hidden></p>
      <p class="cs-status" data-status role="status" aria-live="polite"></p>
      <div class="cs-workspace" data-workspace hidden>
        <div class="cs-document-row">
          <div class="cs-document-title"><h2 data-name>Untitled artwork</h2><span data-dimensions></span></div>
          <button class="cs-secondary" data-new type="button">New page</button>
          <button class="cs-secondary" data-fullscreen type="button" aria-pressed="false">Fullscreen</button>
          <button class="cs-primary" data-download type="button">Download PNG</button>
        </div>
        <div class="cs-layout">
          <aside class="cs-controls" aria-label="Drawing controls">
            <fieldset>
              <legend>Brush</legend>
              <div class="cs-brushes" role="group" aria-label="Brush type">
                <button data-brush="round" type="button" aria-pressed="true"><span aria-hidden="true">●</span>Round</button>
                <button data-brush="pencil" type="button" aria-pressed="false"><span aria-hidden="true">✎</span>Pencil</button>
                <button data-brush="soft" type="button" aria-pressed="false"><span aria-hidden="true">◉</span>Soft</button>
              </div>
              <div class="cs-tools" role="group" aria-label="Other tools">
                <button class="cs-secondary" data-tool="eraser" type="button" aria-pressed="false">Eraser</button>
                <button class="cs-secondary" data-tool="hand" type="button" aria-pressed="false">Hand</button>
              </div>
            </fieldset>
            <label class="cs-slider-label">Size <output data-size-label>24 px</output><input data-size type="range" min="1" max="120" value="24" /></label>
            <label class="cs-slider-label">Opacity <output data-opacity-label>100%</output><input data-opacity type="range" min="10" max="100" value="100" /></label>
            <fieldset>
              <legend>Colors</legend>
              <label class="cs-palette-label"><span class="sr-only">Color palette</span><select data-palette><option value="everyday">Everyday</option><option value="soft">Soft tones</option><option value="earth">Earth &amp; nature</option></select></label>
              <div class="cs-swatches" data-swatches role="group" aria-label="Palette colors"></div>
              <label class="cs-custom-color">Custom color <input data-color type="color" value="#14b8a6" /></label>
            </fieldset>
            <label class="cs-outline-option"><input data-outlines type="checkbox" checked />Keep outlines visible</label>
            <p class="cs-control-note">Works best with dark outlines on a light background. Turn it off to paint over an image.</p>
          </aside>
          <div class="cs-drawing-area">
            <div class="cs-toolbar" role="group" aria-label="History and canvas view">
              <button class="cs-secondary" data-undo type="button" disabled>Undo</button>
              <button class="cs-secondary" data-redo type="button" disabled>Redo</button>
              <button class="cs-secondary" data-clear type="button">Clear coloring</button>
              <label class="cs-zoom-label">Zoom <select data-zoom><option value="fit">Fit</option><option value="0.25">25%</option><option value="0.5">50%</option><option value="0.75">75%</option><option value="1">100%</option><option value="1.5">150%</option><option value="2">200%</option><option value="4">400%</option><option data-custom-zoom value="custom" hidden>Custom</option></select></label>
            </div>
            <div class="cs-viewport" data-viewport tabindex="0" aria-label="Drawing canvas. Choose Hand to drag when zoomed in.">
              <div class="cs-paper" data-paper>
                <canvas data-original aria-hidden="true"></canvas>
                <canvas data-paint role="img" aria-label="Your coloring artwork. Draw with a mouse, touch, or a pen."></canvas>
              </div>
            </div>
            <p class="cs-canvas-note">Scroll to zoom · H Hand to pan · B Brush · E Eraser · Ctrl / ⌘ Z Undo · Shift Ctrl / ⌘ Z Redo</p>
          </div>
        </div>
      </div>
    </div>
    <HowToUse steps={[
      { title: "Choose your starting point", description: "Open a starter page, use a blank canvas, or upload a JPG, PNG, or WebP image." },
      { title: "Explore your brushes and colors", description: "Choose a round, pencil, or soft brush. Set its size and opacity, then paint with your mouse, touch, or pen. Use the eraser or undo to make changes." },
      { title: "Save your artwork", description: "Download a PNG when you are ready. Your original image stays unchanged; download before leaving the page to keep your work." },
    ]} />
    <UsefulDetails>
      <details><summary>What can I upload?</summary><p>Choose a JPG, PNG, or WebP image up to 25 MB and 40 megapixels. Coloring sheets with dark outlines on a light background work best. Large images are resized to a maximum of 2,048 pixels on their longest side; the displayed dimensions are the download size. Animated images are opened as a still frame. PDFs, SVG uploads, and HEIC files are not supported in this version.</p></details>
      <details><summary>How does “Keep outlines visible” work?</summary><p>Colors blend with the original page so dark lines remain visible. This does not stop the brush at outlines or fill enclosed areas automatically. Turn this option off to cover the original image with paint. The eraser removes your coloring, never the original artwork.</p></details>
      <details><summary>Can I use a tablet or drawing pen?</summary><p>You can draw with a mouse, touch, or a pen. On supported devices, pen pressure changes the brush width. Scroll over the canvas to zoom in or out, and choose Hand to move around a zoomed canvas. This first version offers three brushes and one coloring layer; it does not include custom brush imports or editable layer files.</p></details>
      <details><summary>Can I undo changes or continue later?</summary><p>The studio keeps the latest 100 actions in its undo history, including clearing the coloring. Earlier marks remain in the artwork. Your session is not saved after refreshing or closing the page. Download PNG saves a flattened image; it does not preserve an editable coloring layer or undo history.</p></details>
      <details><summary>Are my images uploaded anywhere?</summary><p>No. Uploaded images are decoded and colored in your browser. The starter collection contains coloring pages provided with Papers &amp; Pixels.</p></details>
    </UsefulDetails>
  </div>
</section>
<script src="../scripts/coloring-studio.js"></script>
