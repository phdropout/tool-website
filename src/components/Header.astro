---
import { sitePath } from "../scripts/site-path.js";
import { SITE_NAME } from "../site.js";
---
<header class="site-header">
    <div class="container header-inner">
    <a href={sitePath("/")} class="logo">
        {SITE_NAME}
    </a>

    <nav class="main-nav" aria-label="Main navigation">
        <a href={sitePath("/")}>Home</a>
        <a href={sitePath("/#tools")}>Tools</a>
        <button class="theme-toggle" data-theme-toggle type="button" aria-label="Switch to dark mode" aria-pressed="false" title="Switch to dark mode">
            <svg class="theme-moon" viewBox="0 0 24 24" width="21" height="21" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20.5 14.1A8.5 8.5 0 0 1 9.9 3.5a8.5 8.5 0 1 0 10.6 10.6Z" /></svg>
            <svg class="theme-sun" viewBox="0 0 24 24" width="21" height="21" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" aria-hidden="true"><circle cx="12" cy="12" r="4"/><path d="M12 2v1.5m0 17V22M2 12h1.5m17 0H22M4.9 4.9 6 6m12 12 1.1 1.1M4.9 19.1 6 18M18 6l1.1-1.1"/></svg>
        </button>
    </nav>
    </div>
</header>
