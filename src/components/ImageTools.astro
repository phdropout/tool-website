---
import "../styles/image-tools.css";
import UsefulDetails from "./UsefulDetails.astro";

interface Props {
  activeTab?: "resize" | "compress" | "convert" | "metadata";
}

const { activeTab = "resize" } = Astro.props;
---

<section class="tool-page image-tool-page">
  <div class="container">
    <div class="tool-intro">
      <p class="eyebrow">Your everyday image workspace</p>

      <h1>Image Tools</h1>

      <p>
        Resize, compress, convert, and explore image metadata.
        Everything you need in one simple workspace.
      </p>
      <div class="image-privacy-note">
        <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M12 3 4 6v6c0 4 8 9 8 9s8-5 8-9V6l-8-3Z"/><path d="m8 12 3 3 5-6"/></svg>
        Files stay on your device <span aria-hidden="true">·</span> No sign-up needed
      </div>
    </div>

    <div class="image-tools-card" data-image-tools data-active-tab={activeTab}>
      <div class="tool-tabs" role="tablist" aria-label="Image tools">
        <button
          type="button"
          class:list={["tool-tab", { active: activeTab === "resize" }]}
          aria-selected={activeTab === "resize" ? "true" : "false"}
          tabindex={activeTab === "resize" ? 0 : -1}
          id="resizeTab"
          role="tab"
          aria-controls="resizePanel"
          data-tab="resize"
        >
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M9 4H4v5m11 11h5v-5M4 4l6 6m10 10-6-6M15 4h5v5M4 15v5h5"/></svg>
          Resize
        </button>

        <button
          type="button"
          class:list={["tool-tab", { active: activeTab === "compress" }]}
          aria-selected={activeTab === "compress" ? "true" : "false"}
          tabindex={activeTab === "compress" ? 0 : -1}
          id="compressTab"
          role="tab"
          aria-controls="compressPanel"
          data-tab="compress"
        >
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 4l6 6m0-5v5H5m15 10-6-6m0 5v-5h5M15 4h5v5M4 15v5h5"/></svg>
          Compress
        </button>

        <button
          type="button"
          class:list={["tool-tab", { active: activeTab === "convert" }]}
          aria-selected={activeTab === "convert" ? "true" : "false"}
          tabindex={activeTab === "convert" ? 0 : -1}
          id="convertTab"
          role="tab"
          aria-controls="convertPanel"
          data-tab="convert"
        >
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 8h16m-4-4 4 4-4 4M20 16H4m4-4-4 4 4 4"/></svg>
          Convert
        </button>

        <button
          type="button"
          class:list={["tool-tab", { active: activeTab === "metadata" }]}
          aria-selected={activeTab === "metadata" ? "true" : "false"}
          tabindex={activeTab === "metadata" ? 0 : -1}
          id="metadataTab"
          role="tab"
          aria-controls="metadataPanel"
          data-tab="metadata"
        >
          <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d="M12 11v6m0-10v1"/></svg>
          Metadata
        </button>
      </div>

      <div class="upload-area" id="uploadArea">
        <input
          type="file"
          id="imageInput"
          accept="image/jpeg,image/png,image/webp,image/heic,image/heif,.heic,.heif"
          hidden
        />

        <div class="upload-content">
          <div class="upload-symbol" aria-hidden="true">
            <svg viewBox="0 0 48 48" width="40" height="40" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><rect x="7" y="9" width="34" height="30" rx="5"/><circle cx="17" cy="19" r="3"/><path d="m8 33 10-9 8 7 6-6 9 8"/></svg>
          </div>
          <h2>Start with your image</h2>

          <p>
            Drop it here, or choose a file to get started.
          </p>

          <button type="button" id="chooseImageButton">
            Choose image
          </button>

          <span>JPG, PNG, WebP, HEIC, or HEIF</span>
        </div>
      </div>

      <div class="workspace" id="workspace" hidden>
        <div class="preview-panel">
          <h2>Preview</h2>

          <div class="preview-box">
            <img id="imagePreview" alt="Preview of uploaded image" />
          </div>

          <p class="file-name" id="fileName"></p>
          <p class="original-size" id="originalSize"></p>
          <p class="file-size" id="originalFileSize"></p>

          <button type="button" id="resetButton" class="secondary-action preview-reset">
            Choose another image
          </button>
        </div>

        <div class="controls-panel">
          <section
            class="tab-panel"
            id="resizePanel"
            role="tabpanel"
            aria-labelledby="resizeTab"
            data-panel="resize"
          >
            <h2>Resize image</h2>

            <div class="preset-section">
              <span class="control-label">Quick resize</span>

              <div class="preset-buttons resize-presets" aria-label="Resize percentage presets">
                <button type="button" class="preset-button" data-resize-scale="0.25">25%</button>
                <button type="button" class="preset-button" data-resize-scale="0.5">50%</button>
                <button type="button" class="preset-button" data-resize-scale="0.75">75%</button>
                <button type="button" class="preset-button" data-resize-scale="1">100%</button>
              </div>
            </div>

            <div class="dimension-grid">
              <label>
                Width
                <div class="input-with-unit">
                  <input type="number" id="widthInput" min="1" max="12000" inputmode="numeric" />
                  <span>px</span>
                </div>
              </label>

              <label>
                Height
                <div class="input-with-unit">
                  <input type="number" id="heightInput" min="1" max="12000" inputmode="numeric" />
                  <span>px</span>
                </div>
              </label>
            </div>

            <p class="dimension-note">Maximum output dimension: 12,000 px per side.</p>

            <label class="ratio-control">
              <input type="checkbox" id="lockAspectRatio" checked />
              <span>Keep aspect ratio</span>
            </label>

            <div class="output-settings">
              <label>
                Output format
                <select id="resizeFormatSelect">
                  <option value="original">Same as original</option>
                  <option value="image/jpeg">JPG</option>
                  <option value="image/png">PNG</option>
                  <option value="image/webp">WebP</option>
                </select>
              </label>

              <label>
                <div class="quality-heading">
                  <span>Quality</span>
                  <span id="resizeQualityValue">90%</span>
                </div>

                <input
                  type="range"
                  id="resizeQualityInput"
                  min="10"
                  max="100"
                  value="90"
                  step="1"
                />
              </label>

              <p class="format-note" id="resizePngNotice" hidden>
                PNG uses PNG-specific encoding. Quality settings affect palette reduction rather
                than JPEG-style quality.
              </p>
            </div>

            <button type="button" id="resizeButton" class="primary-action">
              Resize image
            </button>
          </section>

          <section
            class="tab-panel"
            id="compressPanel"
            role="tabpanel"
            aria-labelledby="compressTab"
            data-panel="compress"
          >
            <h2>Compress image</h2>

            <div class="preset-section">
              <span class="control-label">Compression level</span>

              <div class="preset-buttons compress-presets" aria-label="Compression presets">
                <button type="button" class="preset-button" data-compress-quality="90">
                  Light
                  <small>90%</small>
                </button>

                <button type="button" class="preset-button active" data-compress-quality="75">
                  Balanced
                  <small>75%</small>
                </button>

                <button type="button" class="preset-button" data-compress-quality="55">
                  Strong
                  <small>55%</small>
                </button>
              </div>
            </div>

            <div class="output-settings">
              <label>
                Output format
                <select id="compressFormatSelect">
                  <option value="original">Same as original</option>
                  <option value="image/jpeg">JPG</option>
                  <option value="image/png">PNG</option>
                  <option value="image/webp">WebP</option>
                </select>
              </label>

              <label>
                <div class="quality-heading">
                  <span id="compressQualityLabel">Quality</span>
                  <span id="compressQualityValue">75%</span>
                </div>

                <input
                  type="range"
                  id="compressQualityInput"
                  min="10"
                  max="100"
                  value="75"
                  step="1"
                />
              </label>

              <p class="quality-note" id="compressQualityNote">
                Balanced file size and visual quality.
              </p>

              <p class="format-note" id="compressPngNotice" hidden></p>
              <p class="format-note" id="compressHeicNotice" hidden>
                HEIC and HEIF files are not handled in the Compress tab because converting
                them can increase file size. Use the Convert tab instead.
              </p>
            </div>

            <button type="button" id="compressButton" class="primary-action">
              Compress image
            </button>
          </section>

          <section
            class="tab-panel"
            id="convertPanel"
            role="tabpanel"
            aria-labelledby="convertTab"
            data-panel="convert"
          >
            <h2>Convert image</h2>

            <div class="output-settings">
              <label>
                Convert to
                <select id="convertFormatSelect">
                  <option value="image/jpeg">JPG</option>
                  <option value="image/png">PNG</option>
                  <option value="image/webp">WebP</option>
                </select>
              </label>

              <label id="convertQualityControl">
                <div class="quality-heading">
                  <span>Quality</span>
                  <span id="convertQualityValue">90%</span>
                </div>

                <input
                  type="range"
                  id="convertQualityInput"
                  min="10"
                  max="100"
                  value="90"
                  step="1"
                />
              </label>

              <p class="format-note" id="convertFormatNote">
                Choose a new format. HEIC and HEIF images can be converted to JPG, PNG, or WebP.
              </p>
            </div>

            <button type="button" id="convertButton" class="primary-action">
              Convert image
            </button>
          </section>


          <section
            class="tab-panel"
            id="metadataPanel"
            role="tabpanel"
            aria-labelledby="metadataTab"
            data-panel="metadata"
          >
            <h2>Image metadata</h2>

            <p class="metadata-intro">
              View file details and embedded metadata stored inside the image.
              Metadata stays on your device.
            </p>

            <div class="metadata-summary" id="metadataSummary">
              <div class="metadata-item">
                <span>File name</span>
                <strong id="metadataFileName">—</strong>
              </div>

              <div class="metadata-item">
                <span>Format</span>
                <strong id="metadataFormat">—</strong>
              </div>

              <div class="metadata-item">
                <span>File size</span>
                <strong id="metadataFileSize">—</strong>
              </div>

              <div class="metadata-item">
                <span>Dimensions</span>
                <strong id="metadataDimensions">—</strong>
              </div>

              <div class="metadata-item">
                <span>Aspect ratio</span>
                <strong id="metadataAspectRatio">—</strong>
              </div>

              <div class="metadata-item">
                <span>Last modified</span>
                <strong id="metadataLastModified">—</strong>
              </div>
            </div>

            <div class="metadata-section">
              <div class="metadata-heading">
                <h3>Embedded metadata</h3>
                <span id="metadataStatus">Reading metadata…</span>
              </div>

              <div class="metadata-table" id="metadataTable"></div>

              <p class="metadata-empty" id="metadataEmpty" hidden>
                No additional embedded metadata was found in this image.
              </p>
            </div>
          </section>

        </div>
      </div>

      <p class="error-message" id="errorMessage" role="alert" hidden></p>
      <div class="result-panel" id="resultPanel" hidden>
        <div>
          <p class="eyebrow" id="resultEyebrow">Ready</p>
          <h2 id="resultTitle">Your image is ready</h2>
          <p id="resultDimensions"></p>

          <div class="result-stats" id="resultStats">
            <div>
              <span>Original</span>
              <strong id="resultOriginalSize"></strong>
            </div>

            <div>
              <span>Output</span>
              <strong id="resultOutputSize"></strong>
            </div>

            <div>
              <span>Change</span>
              <strong id="resultChange"></strong>
            </div>
          </div>

          <p id="resultNote"></p>
        </div>

        <a id="downloadButton" class="download-button" download>
          Download image
        </a>
      </div>
    </div>
  </div>
</section>

<section class="tool-info-section image-tool-info">
  <div class="container info-container">
    <div class="info-block">
      <p class="eyebrow">One workspace</p>
      <h2>Resize, compress, or convert without uploading again</h2>

      <p>
        Choose an image once, then switch between the Resize, Compress, Convert, and Metadata tabs.
        Each tab shows only the controls or information needed for that task.
      </p>
    </div>

    <div class="privacy-block">
      <h2>Processed in your browser</h2>

      <p>
        Image processing happens locally in your browser. Your selected image is not
        uploaded to this website for processing.
      </p>
    </div>

    <UsefulDetails>
      <details>
        <summary>Which image formats are supported?</summary>
        <p>
          You can open JPG, PNG, WebP, HEIC, and HEIF images. The current output
          formats are JPG, PNG, and WebP.
        </p>
      </details>

      <details>
        <summary>Why are Resize, Compress, and Convert separate tabs?</summary>
        <p>
          Each task has a different goal. Resize changes dimensions, Compress focuses
          on file size, and Convert changes the image format. Keeping them in one
          workspace avoids duplicate uploads while keeping the controls focused.
        </p>
      </details>

      <details>
        <summary>Can HEIC or HEIF files be compressed directly?</summary>
        <p>
          No. HEIC and HEIF files are handled in the Convert tab instead. Converting
          them to JPG, PNG, or WebP can increase file size, so the Compress tab stays
          focused on JPG, PNG, and WebP compression.
        </p>
      </details>

      <details>
        <summary>What metadata can the tool display?</summary>
        <p>
          The Metadata tab always shows basic file details such as format, file size,
          dimensions, and last-modified time. When present, it can also display
          embedded Exif, IPTC, XMP, ICC, GPS, and camera information.
        </p>
      </details>

      <details>
        <summary>Is my image uploaded anywhere?</summary>
        <p>
          No. The processing is performed locally in your browser using browser-side
          image-processing libraries.
        </p>
      </details>
    </UsefulDetails>
  </div>
</section>

<script src="../scripts/image-tools.js"></script>
