---
import BaseLayout from "../layouts/BaseLayout.astro";

const tools = [
  {
    title: "Image Tools",
    description:
      "Resize, compress, and convert images in one browser-based workspace.",
    href: "/image-tools/",
  },
  {
    title: "Countdown Timer",
    description:
      "A clean fullscreen countdown timer for exams, classrooms, presentations, and events.",
    href: "/countdown-timer/",
  },
  {
    title: "Image to PDF",
    description:
      "Turn one or more images into a downloadable PDF.",
    href: "#",
  },
  {
    title: "Merge PDF",
    description:
      "Combine multiple PDF files into one document.",
    href: "#",
  },
  {
    title: "Split PDF",
    description:
      "Extract pages or split a PDF into smaller documents.",
    href: "#",
  },
  {
    title: "CSV to JSON",
    description:
      "Convert CSV data into structured JSON.",
    href: "#",
  },
  {
    title: "Remove CSV Duplicates",
    description:
      "Find and remove duplicate rows from CSV files.",
    href: "#",
  },
  {
    title: "Favicon Generator",
    description:
      "Generate favicon files for websites from your image.",
    href: "#",
  },
];
---

<BaseLayout
  title="Free Online Tools"
  description="Simple browser-based tools for images, PDFs, CSV files, timers, and more."
>
  <section class="hero">
    <div class="container">
      <p class="eyebrow">Simple browser-based utilities</p>

      <h1>
        Useful tools without the clutter.
      </h1>

      <p class="hero-description">
        Convert, resize, compress, and process files with simple tools
        designed to get the job done quickly.
      </p>

      <a href="#tools" class="primary-button">
        Browse tools
      </a>
    </div>
  </section>

  <section class="tools-section" id="tools">
    <div class="container">
      <div class="section-heading">
        <p class="eyebrow">Tools</p>

        <h2>
          What do you need to do?
        </h2>
      </div>

      <div class="tool-grid">
        {
          tools.map((tool) => (
            <a
              class={`tool-card ${tool.href === "#" ? "coming-soon" : ""}`}
              href={tool.href}
            >
              <h3>{tool.title}</h3>

              <p>{tool.description}</p>

              <span class="tool-link">
                {tool.href === "#" ? "Coming soon" : "Open tool →"}
              </span>
            </a>
          ))
        }
      </div>
    </div>
  </section>
</BaseLayout>
