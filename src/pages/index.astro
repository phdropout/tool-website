---
import { sitePath } from "../scripts/site-path.js";
import BaseLayout from "../layouts/BaseLayout.astro";

const tools = [
  {
    title: "Image Tools",
    description:
      "Resize, compress, and convert images in one browser-based workspace.",
    href: "/image-tools/",
    icon: "M4 4h16v16H4z M8 16l4-5 4 5 2-2 2 2 M8 8h.01",
  },
  {
    title: "Countdown Timer",
    description:
      "Set a countdown for focused work, presentations, meetings, or events.",
    href: "/countdown-timer/",
    icon: "M9 3h6 M12 7a7 7 0 1 0 0 14 7 7 0 0 0 0-14 M12 10v4l2 2 M17 6l2-2",
  },
  {
    title: "Image to PDF",
    description:
      "Turn one or more images into a downloadable PDF.",
    href: "/image-to-pdf/",
    icon: "M14 3H6v18h12V7l-4-4z M14 3v5h4 M9 12h6 M9 16h6",
  },
  {
    title: "Merge PDF",
    description:
      "Choose, arrange, and combine PDF pages into one document.",
    href: "/merge-pdf/",
    icon: "M4 3h6v7H4z M14 3h6v7h-6z M7 10v4h10v-4 M12 14v7 M9 18l3 3 3-3",
  },
  {
    title: "PDF Viewer",
    description:
      "Read PDFs, highlight text, and mark scanned pages with a highlighter brush.",
    href: "/pdf-viewer/",
    icon: "M14 3H6v18h12V7l-4-4z M14 3v5h4 M9 12h6 M9 16h4",
  },
  {
    title: "Photo & Video Viewer",
    description:
      "Browse photos and videos by folder, with fullscreen viewing and slideshows.",
    href: "/media-viewer/",
    icon: "M3 5h18v14H3z M8 10h.01 M4 17l5-5 4 4 M15 9l4 3-4 3z",
  },
];
---

<BaseLayout
  title="Free Online Tools"
  description="Resize and convert images, create and annotate PDFs, browse photos and videos, and keep time with Papers & Pixels."
>
  <section class="hero">
    <div class="container">
      <p class="eyebrow">Everyday essentials</p>

      <h1>
        Your workspace for documents and images.
      </h1>

      <p class="hero-description">
        Prepare images, put documents in order, and focus on the details.
        Practical tools for the work in front of you.
      </p>

      <a href="#tools" class="primary-button">
        Browse tools <span aria-hidden="true">→</span>
      </a>
    </div>
  </section>

  <section class="tools-section" id="tools">
    <div class="container">
      <div class="section-heading">
        <p class="eyebrow">Tools</p>

        <h2>
          Choose your next task
        </h2>
      </div>

      <div class="tool-grid">
        {
          tools.map((tool) => (
            <a class="tool-card" href={sitePath(tool.href)}>
              <span class="tool-icon" aria-hidden="true">
                <svg viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d={tool.icon} /></svg>
              </span>
              <h3>{tool.title}</h3>

              <p>{tool.description}</p>

              <span class="tool-link">
                Open tool <span aria-hidden="true">→</span>
              </span>
            </a>
          ))
        }
      </div>

    </div>
  </section>
</BaseLayout>
